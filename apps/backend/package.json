{
  "name": "@vektorprogrammet/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./application/worker": "./src/application/worker.ts",
    "./delivery/http": "./src/delivery/http.ts",
    "./http-semantics": "./src/http-semantics.ts",
    "./mail/http": "./src/mail/http.ts",
    "./onboarding/delivery": "./src/onboarding/delivery.ts",
    "./receipt/delivery": "./src/receipt/delivery.ts",
    "./receipt/filesystem": "./src/receipt/filesystem.ts",
    "./receipt/import-snapshot": "./src/receipt/import-snapshot.ts",
    "./receipt/payment-account": "./src/receipt/payment-account.ts",
    "./receipt/reviewed-import": "./src/receipt/reviewed-import.ts",
    "./session-security": "./src/session-security.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun run --watch src/main.ts",
    "generate": "bun ../../node_modules/@effx/cli/dist/effx.js build --project tsconfig.effx.json --strict-access --emit=handlers",
    "check-types": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:effect-v4",
    "@noble/hashes": "catalog:effect-v4",
    "@react-email/render": "2.1.0",
    "@vektorprogrammet/database": "workspace:*",
    "@vektorprogrammet/domain": "workspace:*",
    "@vektorprogrammet/http-api": "workspace:*",
    "effect": "catalog:effect-v4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.11.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect-v4",
    "@monoweb/postgres": "workspace:*",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxlint": "^1.41.0",
    "typescript": "7.0.2",
    "vitest": "catalog:effect-v4"
  }
}
