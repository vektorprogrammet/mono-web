# API mode is not used by the Receipt SDK journey; leave it unset/non-fixture.
# VITE_API_MODE=remote

# Required server-side API base URL for dashboard loaders and actions.
# There is no default destination.
# API_URL=http://127.0.0.1:8787

# Required server-only Symfony origin for the interim password-recovery adapter.
# Use an exact HTTPS origin, or fixed-port http://127.0.0.1 for local development.
# LEGACY_SYMFONY_PASSWORD_RECOVERY_URL=http://127.0.0.1:8000
