    "cmdk": "^1.1.1",
    "effect": "catalog:effect-v4",
    "foldkit": "catalog:effect-v4",
    "isbot": "^5.1.25",
    "lucide-react": "^0.486.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.55.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.17",
    "tailwindcss-animate": "^1.0.7",
    "tanstack": "^1.0.0",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
