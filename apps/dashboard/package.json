{
  "name": "@monoweb/dashboard",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#dashboard-server-build": {
      "types": "./workers/server-build.d.ts",
      "default": "./build/server/index.js"
    }
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "bun server.mjs",
    "check-types": "react-router typegen && tsc",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "test": "vitest run && bun run test:preview-bundle-gate",
    "test:preview-bundle-gate": "bun scripts/assert-preview-devtools-bundles.mjs",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "e2e:real-content-publication": "bun e2e/run-real-native-content-publication.mjs",
    "e2e:real-social-events": "bun e2e/run-real-native-social-events.mjs",
    "e2e:real-school-survey": "bun e2e/run-real-native-school-survey.mjs",
    "e2e:real-survey-operations": "bun e2e/run-real-native-survey-operations.mjs",
    "e2e:test": "node ./node_modules/@playwright/test/cli.js test",
    "e2e:test:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
    "e2e:test:chrome": "node ./node_modules/@playwright/test/cli.js test --project=chromium",
    "e2e:test:firefox": "node ./node_modules/@playwright/test/cli.js test --project=firefox",
    "e2e:test:webkit": "node ./node_modules/@playwright/test/cli.js test --project=webkit",
    "e2e:test:generate": "node ./node_modules/@playwright/test/cli.js codegen",
    "e2e:show-report": "node ./node_modules/@playwright/test/cli.js show-report",
    "e2e:install": "node ./node_modules/@playwright/test/cli.js install",
    "e2e:real-approval": "bun e2e/run-real-receipt-approval.mjs",
    "e2e:real-settlement": "bun --conditions=@vektorprogrammet/source e2e/run-real-native-receipt-settlement.mjs",
    "e2e:real-owner": "bun e2e/run-real-receipt-owner.mjs",
    "e2e:real-admission-periods": "bun e2e/run-real-admission-period-management.mjs",
    "e2e:real-recruitment": "bun ../../tools/e2e/run-real-native-recruitment-assignment.mjs",
    "e2e:real-core-journeys": "bun --no-env-file ../../scripts/require-legacy-profile.ts && bun e2e/run-real-symfony-core-journeys.mjs",
    "e2e:real-org-operations": "bun --no-env-file ../../scripts/require-legacy-profile.ts && bun e2e/run-real-symfony-org-operations.mjs",
    "e2e:real-background-operations": "bun --no-env-file ../../scripts/require-legacy-profile.ts && bun e2e/run-real-symfony-background-operations.mjs",
    "e2e:real-scheduling": "bun e2e/run-real-native-recruitment-interview-scheduling.mjs",
    "e2e:real-conduct": "bun e2e/run-real-native-recruitment-interview-conduct.mjs",
    "e2e:real-organization": "bun e2e/run-real-native-organization-administration.mjs",
    "e2e:real-substitutes": "bun --no-env-file ../../tools/preview-host/substitute-pool-check.ts --browser",
    "e2e:real-schools": "bun e2e/run-real-native-schools-directory.mjs",
    "e2e:real-interview-response": "bun e2e/run-real-interview-response.mjs",
    "e2e:real-profile": "node e2e/run-real-native-profile-self-edit.mjs",
    "e2e:real-content-ops": "bun --no-env-file ../../scripts/require-legacy-profile.ts && bun e2e/run-real-content-ops.mjs",
    "e2e:real-identity": "bun --no-env-file e2e/run-real-native-identity-browser.mjs",
    "e2e:real-oauth": "node ./node_modules/@playwright/test/cli.js test e2e/native-oauth-consent.spec.ts --project=chromium --workers=1 --retries=0",
    "e2e:merge-runtime-evidence": "bun e2e/merge-runtime-evidence.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@foldkit/ui": "catalog:effect-v4",
    "@mantine/hooks": "^7.17.3",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@tailwindcss/vite": "^4.0.17",
    "@tanstack/react-table": "^8.21.2",
    "@vektorprogrammet/http-api": "workspace:*",
    "@vektorprogrammet/sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "catalog:effect-v4",
    "foldkit": "catalog:effect-v4",
    "isbot": "^5.1.25",
    "lucide-react": "^0.486.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.17",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.12",
    "@effect/vitest": "catalog:effect-v4",
    "@foldkit/vite-plugin": "0.24.0",
    "@monoweb/postgres": "workspace:*",
    "@playwright/test": "^1.51.1",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vektorprogrammet/backend": "workspace:*",
    "@vektorprogrammet/placements": "workspace:*",
    "happy-dom": "^20.12.0",
    "pg": "8",
    "typescript": "7.0.2",
    "vite": "^8.0.7",
    "vitest": "catalog:effect-v4"
  },
  "engines": {
    "node": ">=22"
  }
}
