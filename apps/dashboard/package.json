{
  "name": "@monoweb/dashboard",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve build/server/index.js",
    "check-types": "react-router typegen && tsc",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "test": "vitest run",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "e2e:test": "node ./node_modules/@playwright/test/cli.js test",
    "e2e:test:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
    "e2e:test:chrome": "node ./node_modules/@playwright/test/cli.js test --project=chromium",
    "e2e:test:firefox": "node ./node_modules/@playwright/test/cli.js test --project=firefox",
    "e2e:test:webkit": "node ./node_modules/@playwright/test/cli.js test --project=webkit",
    "e2e:test:generate": "node ./node_modules/@playwright/test/cli.js codegen",
    "e2e:show-report": "node ./node_modules/@playwright/test/cli.js show-report",
    "e2e:install": "node ./node_modules/@playwright/test/cli.js install",
    "e2e:real-approval": "bun e2e/run-real-receipt-approval.mjs",
    "e2e:real-owner": "bun e2e/run-real-receipt-owner.mjs",
    "e2e:real-admission-periods": "bun e2e/run-real-admission-period-management.mjs",
    "e2e:real-recruitment": "bun e2e/run-real-symfony-recruitment.mjs",
    "e2e:real-core-journeys": "bun e2e/run-real-symfony-core-journeys.mjs",
    "e2e:real-org-operations": "bun e2e/run-real-symfony-org-operations.mjs",
    "e2e:real-background-operations": "bun e2e/run-real-symfony-background-operations.mjs",
    "e2e:real-scheduling": "bun e2e/run-real-native-recruitment-interview-scheduling.mjs",
    "e2e:real-interview-response": "bun e2e/run-real-interview-response.mjs",
    "e2e:real-organization": "bun e2e/run-real-native-organization-administration.mjs",
    "e2e:real-content-ops": "bun e2e/run-real-content-ops.mjs",
    "e2e:merge-runtime-evidence": "bun e2e/merge-runtime-evidence.mjs"
  },
