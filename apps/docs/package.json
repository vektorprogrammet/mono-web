{
  "name": "@monoweb/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "bun run --cwd ../../packages/http-api generate && bun run --cwd ../../packages/sdk generate && bun --no-env-file markdown/prerender.ts && vite dev",
    "build": "bun --no-env-file scripts/build.ts",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "generate": "bun run --cwd ../../packages/http-api generate && bun --no-env-file markdown/cli.ts write",
    "check": "bun run --cwd ../../packages/http-api generate && bun --no-env-file markdown/cli.ts check",
    "test": "bun test tests"
  },
  "dependencies": {
    "@monoweb/conventions": "workspace:*",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "@tanstack/start-static-server-functions": "1.167.37",
    "cn": "^0.4.0",
    "effect": "catalog:effect-v4",
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-openapi": "12.0.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.14",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/estree": "1.0.8",
    "@types/mdast": "4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "github-slugger": "2.0.0",
    "mdast-util-mdx": "3.0.0",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.61.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "vite": "^8.3.1"
  }
