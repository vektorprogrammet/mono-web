{
  "name": "@monoweb/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pages": "bun --no-env-file scripts/sync-pages.ts",
    "dev": "bun run --cwd ../../packages/http-api generate && (bun --no-env-file scripts/sync-pages.ts --watch & vocs dev)",
    "build": "bun run --cwd ../../packages/http-api generate && bun --no-env-file scripts/sync-pages.ts && vocs build",
    "preview": "vocs preview",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "cn": "0.4.0",
    "mermaid": "11.17.2",
    "motion": "12.35.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0",
    "vocs": "2.10.0",
    "waku": "1.0.0-rc.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vfile": "6.0.3",
    "vite": "8.3.1"
  }
}
