{
  "name": "@monoweb/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun scripts/generate-reference.ts && oxfmt --write public/migration-state.json public/migration-state.schema.json src/pages/reference/migration-state.mdx src/pages/reference/design-spec-evidence-index.mdx",
    "dev": "bun run generate && vocs dev",
    "build": "bun run generate && vocs build",
    "preview": "vocs preview",
    "check-types": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "mermaid": "11.17.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vocs": "2.8.5",
    "waku": "1.0.0-beta.3",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
