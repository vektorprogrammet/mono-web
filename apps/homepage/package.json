{
  "name": "@monoweb/homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "worker:build": "vite build",
    "worker:dev": "vite preview --host 127.0.0.1 --port 8787 --strictPort",
    "check-types": "react-router typegen && tsc",
    "test:resolver": "vitest run --config vitest.config.ts test/host.test.ts",
    "test:dev-content": "vitest run test/dev-content.test.ts",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest watch",
    "e2e:test": "playwright test",
    "e2e:test:ui": "playwright test --ui",
    "e2e:show-report": "playwright show-report",
    "e2e:install": "playwright install",
    "e2e:applicant:real": "bun e2e/run-real-public-applicant-admission.mjs",
    "e2e:homepage": "playwright test e2e/homepage-dev-journey.spec.ts --workers=1 --retries=0 --reporter=line",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "e2e:contact:native": "node e2e/run-native-contact.mjs"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^12.3.0",
