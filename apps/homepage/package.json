    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@tailwindcss/vite": "^4.0.17",
    "@vektorprogrammet/http-api": "workspace:*",
    "@vektorprogrammet/sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "catalog:effect-v4",
    "isbot": "^5.1.25",
    "lucide-react": "^0.486.0",
    "motion": "^12.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.0.2",
