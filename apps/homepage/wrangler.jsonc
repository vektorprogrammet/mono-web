{
  "name": "monoweb-homepage-local",
  "main": "workers/app.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
