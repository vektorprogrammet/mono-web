}

BoundedContext MailProvider {
  type = SYSTEM
  domainVisionStatement = "External mail delivery; selected at cutover preparation."
}

BoundedContext HkDirCatalogue {
  type = SYSTEM
  domainVisionStatement = "NTNU or DBH (HK-dir) catalogue of fields of study; candidate source only."
}
