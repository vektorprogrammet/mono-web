      Instant endsAt
      "capability: social-events.create; requirement: department member with the event grant; scope: department; decisionTime: Transaction"
      def void announceEvent(DepartmentId departmentId, SemesterId semesterId, String title, Instant startsAt, Instant endsAt) : write;
    }
    ValueObject SocialEventId {
      String value key
    }
  }
}

BoundedContext Content implements PublicPresence {
  type = FEATURE
  domainVisionStatement = "Public articles with drafts and published versions, public page text and sponsor presentation. Bodies are sanitized; slugs are unique."
  responsibilities = "Articles", "Page text", "Sponsors"

  Aggregate Article {
    Entity Article {
      aggregateRoot
      - ArticleId articleId
      String slug
      String draftBody
      int publishedVersion
      int revision
      - ArticleLifecycle lifecycle
      "capability: content.articles.edit; requirement: editor in an active department; scope: article-departments; decisionTime: Transaction"
      def void createDraft(String title, String body) : write [ -> ArticleDraft ];
      def void reviseDraft(String body, int expectedRevision) : write;
      "capability: content.articles.publish; requirement: publisher; a leader may not publish organization-wide articles"
      def void publishArticle(int expectedRevision) : write [ ArticleDraft, ArticleUnpublished -> ArticlePublished ];
      def void unpublishArticle(int expectedRevision) : write [ ArticlePublished -> ArticleUnpublished ];
    }
    ValueObject ArticleId {
      int value key
    }
    enum ArticleLifecycle {
      aggregateLifecycle
      ArticleDraft, ArticlePublished, ArticleUnpublished
    }
  }

  Aggregate PageText {
    Entity PageText {
      aggregateRoot
      String pageKey
      String body
      int revision
      def void revisePageText(String body, int expectedRevision) : write;
    }
  }

  Aggregate SponsorPresentation {
    Entity Sponsor {
      aggregateRoot
      String sponsorKey
      String name
      String logoRef
      int revision
      def void reviseSponsor(String name, String logoRef, int expectedRevision) : write;
    }
  }
}

BoundedContext Contact implements PublicPresence {
  type = FEATURE
  domainVisionStatement = "Relays a visitor's contact message to an active department mailbox. The message is transient; only the quota is durable. Submission is anonymous and rate limited per visitor address. The homepage server authenticates to the backend with a deployment secret; that secret names no principal."
  responsibilities = "Contact quota", "Contact relay"

  "invariant: at most a fixed number of attempts per visitor address per rolling window; the attempt is consumed before recipient lookup or delivery and is never refunded."
  Aggregate ContactQuota {
    Entity ContactQuota {
      aggregateRoot
      String visitorAddress
      Instant windowStart
      int attempts
      def void consumeAttempt(Instant now) : write;
    }
  }
}

BoundedContext Mailing implements Outreach {
  type = FEATURE
  domainVisionStatement = "Mailing recipients for a department, semester and cohort (assistants, team members, union), native list administration and automated Google Workspace synchronization. Reads do not administer subscriptions or send mail."
  responsibilities = "Recipient projection", "Mailing lists", "Workspace synchronization"

  Aggregate MailingList {
    Entity MailingList {
      aggregateRoot
      - MailingListId mailingListId
      DepartmentId departmentId
      String cohort
      String workspaceGroup
      - MailingListLifecycle lifecycle
      def void defineList(DepartmentId departmentId, String cohort) : write [ -> ListActive ];
      def void retireList() : write [ ListActive -> ListRetired* ];
      def void synchronizeWorkspace() : write;
    }
    ValueObject MailingListId {
      String value key
    }
    enum MailingListLifecycle {
      aggregateLifecycle
      ListActive, ListRetired
    }
  }

  Service RecipientProjection {
    "Current authority and recipient facts share one read snapshot. An explicit semester must exist; an omitted semester resolves to the unique current one. capability: mailing.recipients.read; requirement: board.seat covering departmentId OR global.administrator (every department); decisionTime: SnapshotRead"
    String recipients(DepartmentId departmentId, SemesterId semesterId, String cohort) : read-only;
  }
}

BoundedContext Messaging implements Outreach {
  type = FEATURE
  domainVisionStatement = "Admission-opening notices with subscription consent and unsubscribe, accept-interview reminders and staff interview digests. Email only."
  responsibilities = "Notice subscriptions", "Reminders", "Digests"

  Aggregate NoticeSubscription {
    Entity NoticeSubscription {
      aggregateRoot
      - SubscriptionId subscriptionId
      ContactEmail emailAddress
      DepartmentId departmentId
      - SubscriptionLifecycle lifecycle
      def void subscribeToNotices(ContactEmail emailAddress, DepartmentId departmentId) : write [ -> Subscribed ];
      def void unsubscribeFromNotices(String unsubscribeToken) : write [ Subscribed -> Unsubscribed* ];
    }
    ValueObject SubscriptionId {
      String value key
    }
    enum SubscriptionLifecycle {
      aggregateLifecycle
      Subscribed, Unsubscribed
    }
  }
}

BoundedContext Delivery implements DurableDelivery {
  type = SYSTEM
  domainVisionStatement = "Every command that needs external work commits one immutable envelope with its business fact. Workers claim, attempt, acknowledge or retry after commit. Retry reuses the envelope and effect identity; a provider failure never rolls back the business fact."
  responsibilities = "Outbox envelopes", "Claims and fencing", "Retry and quarantine", "Mail port"

  "invariant: the first envelope is immutable. invariant: a claim is exclusive and fenced; a lost claim is a typed failure. invariant: an effect stays behind an undelivered predecessor of the same owner when ordering is declared. invariant: historical import never enqueues."
  Aggregate OutboxEnvelope {
    Entity OutboxEnvelope {
      aggregateRoot
      - EffectId effectId
      String owningContext
      String owningFact
      String payload
      int attempts
      - EnvelopeLifecycle lifecycle
      def void enqueue(String owningFact, String payload) : write [ -> EnvelopePending ];
      def void claim(String claimId) : write [ EnvelopePending -> EnvelopeClaimed ];
      def void acknowledge(String claimId) : write [ EnvelopeClaimed -> EnvelopeDelivered* ];
      def void failAttempt(String claimId) : write [ EnvelopeClaimed -> EnvelopePending ];
      def void quarantine(String claimId) : write [ EnvelopeClaimed -> EnvelopeQuarantined* ];
      "The owning context cancels undelivered work (for example a deleted team application) and clears the private payload."
      def void cancel() : write [ EnvelopePending, EnvelopeClaimed -> EnvelopeCancelled* ];
    }
    ValueObject EffectId {
      String value key
    }
    enum EnvelopeLifecycle {
      aggregateLifecycle
      EnvelopePending, EnvelopeClaimed, EnvelopeDelivered, EnvelopeQuarantined, EnvelopeCancelled
    }
  }
}

BoundedContext Reporting implements OperationalReporting {
  type = FEATURE
  domainVisionStatement = "Read models over owned facts: applicant progress and coordinator reports (an archive export at cutover; each report is built for a named consumer). Reports accept no commands."
  responsibilities = "Applicant progress", "Coordinator reports"

  Aggregate ApplicantProgressView {
    "Shows recorded facts in sequence (interview, invitation, claim, affiliation, placement); it never invents an admission answer."
    ValueObject ApplicantProgress {
      ApplicantId applicantId
      String stage
    }
    Service ApplicantProgressProjection {
      @ApplicantProgress progressOf(ApplicantId applicantId) : read-only;
    }
  }
}

