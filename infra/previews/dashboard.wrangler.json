{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vektor-preview-dashboard",
  "workers_dev": false,
  "preview_urls": true,
  "main": "../../apps/dashboard/workers/preview-app.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../apps/dashboard/build/client",
    "run_worker_first": true
  },
  "previews": {
    "vars": {
      "DASHBOARD_MOUNT": "/",
      "PREVIEW_HOST_SUFFIX": ".workers.dev",
      "PREVIEW_STAGE": "worker-preview"
    }
  }
}
