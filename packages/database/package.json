{
  "name": "@vektorprogrammet/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admission-period": "./src/admission-period/index.ts",
    "./admissions": "./src/admissions/index.ts",
    "./application": "./src/application/index.ts",
    "./authz": "./src/authz/index.ts",
    "./contact": "./src/contact/index.ts",
    "./content": "./src/content/index.ts",
    "./onboarding": "./src/onboarding/index.ts",
    "./organization": "./src/organization/index.ts",
    "./placements": "./src/placements/index.ts",
    "./profile": "./src/profile/index.ts",
    "./receipt": "./src/receipt/index.ts",
    "./receipt/postgres": "./src/receipt/postgres-index.ts",
    "./receipt/proof": "./src/receipt/proof-index.ts",
    "./recruitment": "./src/recruitment/index.ts",
    "./schools": "./src/schools/index.ts",
    "./social-events": "./src/social-events/index.ts",
    "./substitutes": "./src/substitutes/index.ts",
    "./surveys": "./src/surveys/index.ts"
  },
  "scripts": {
    "test": "vitest run --no-file-parallelism",
    "proof:receipt": "bun run runtime/receipt-postgres-proof-main.ts",
    "proof:authorization-rules": "bun run runtime/authorization-rules-postgres-proof-main.ts",
    "trace:rule-reconciliation": "bun run runtime/rule-reconciliation-postgres-tracer-main.ts",
    "proof:scheduling-postgres": "bun run runtime/scheduling-postgres-proof-main.ts",
    "proof:invitation-response-postgres": "bun run runtime/invitation-response-postgres-proof-main.ts",
    "proof:organization-postgres": "bun run runtime/organization-postgres-proof-main.ts",
    "proof:content-postgres": "bun run runtime/content-postgres-proof-main.ts",
    "proof:schools-postgres": "bun run runtime/schools-postgres-proof-main.ts",
    "proof:identity-postgres": "bun run runtime/identity-postgres-proof-main.ts",
    "proof:schema-boundary-postgres": "bun run runtime/schema-boundary-postgres-proof-main.ts",
    "trace:oauth-postgres": "bun run runtime/oauth-postgres-tracer-main.ts",
    "trace:service-principal-grants-postgres": "bun run runtime/service-principal-grants-postgres-tracer-main.ts",
    "fixture:oauth-dashboard-postgres": "bun run runtime/oauth-dashboard-fixture-main.ts",
    "proof:profile-postgres": "bun run runtime/profile-postgres-proof-main.ts",
    "identity:seed": "bun run runtime/identity-seed-main.ts",
    "proof:identity-browser": "bun run runtime/identity-browser-proof-main.ts",
    "rehearsal:organization-import": "bun run runtime/organization-import-rehearsal-main.ts",
    "check-types": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "oxlint",
    "rehearsal:receipt-import": "bun run runtime/receipt-import-rehearsal.ts",
    "rehearsal:person-cohort": "bun run runtime/person-cohort-rehearsal.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.1",
    "@effect/platform-bun": "catalog:effect-v4",
    "@effect/sql-pg": "catalog:effect-v4",
    "@types/pg": "^8.23.1",
    "@vektorprogrammet/domain": "workspace:*",
    "better-auth": "1.7.1",
    "effect": "catalog:effect-v4",
    "pg": "8"
  },
  "devDependencies": {
    "@effect/sql-pglite": "catalog:effect-v4",
    "@effect/vitest": "catalog:effect-v4",
    "@electric-sql/pglite": "^0.5.6",
    "@types/node": "^22",
    "oxlint": "^1.41.0",
    "typescript": "^5",
    "vitest": "catalog:effect-v4"
  }
}
