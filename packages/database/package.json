{
  "name": "@vektorprogrammet/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admission-period": "./src/admission-period/index.ts",
    "./admissions": "./src/admissions/index.ts",
    "./application": "./src/application/index.ts",
    "./auth": "./src/auth-live.ts",
    "./authz": "./src/authz/index.ts",
    "./contact": "./src/contact/index.ts",
    "./cohort-cli": "./src/cohort-cli.ts",
    "./content": "./src/content/index.ts",
    "./historical-service-cohort": "./src/historical-service-cohort.ts",
    "./identity-cohort": "./src/identity-cohort.ts",
    "./onboarding": "./src/onboarding/index.ts",
    "./organization": "./src/organization/index.ts",
    "./outbox-lifecycle": "./src/outbox-lifecycle.ts",
    "./live": "./src/layers.ts",
    "./migrations": "./src/migrations.ts",
    "./password-recovery": "./src/password-recovery.ts",
    "./person-cohort": "./src/person-cohort.ts",
    "./profile": "./src/profile/index.ts",
    "./receipt/postgres": "./src/receipt/postgres-index.ts",
    "./runtime": "./src/runtime-layer.ts",
    "./recruitment": "./src/recruitment/index.ts",
    "./schools": "./src/schools/index.ts",
    "./social-events": "./src/social-events/index.ts",
    "./substitutes": "./src/substitutes/index.ts",
