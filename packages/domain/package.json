{
  "name": "@vektorprogrammet/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./data": "./src/data.ts",
    "./runtime-services": "./src/runtime-services.ts",
    "./runtime/node": "./runtime/node.ts",
    "./laws": "./src/laws.ts",
    "./report": "./src/report.ts",
    "./fixtures": "./src/fixtures.ts",
    "./capabilities": "./src/capabilities.ts",
    "./authz": "./src/authz/decision.ts",
    "./receipt": "./src/receipt/index.ts",
    "./receipt/postgres": "./src/receipt/postgres-index.ts",
    "./application": "./src/application/index.ts",
    "./admission-period": "./src/admission-period/index.ts",
    "./admissions": "./src/admissions/index.ts",
    "./organization": "./src/organization/index.ts",
    "./profile": "./src/profile/index.ts",
    "./schools": "./src/schools/index.ts",
    "./auth": "./src/auth/index.ts",
    "./recruitment": "./src/recruitment/index.ts",
    "./notification": "./src/notification/index.ts",
    "./database": "./src/database/index.ts",
    "./evidence": "./src/tutor/evidence.ts",
    "./receipt/proof": "./src/receipt/proof-index.ts"
  },
  "scripts": {
    "report": "bun run runtime/main.ts",
    "proof:d1": "bun run runtime/tutor-d1-proof-main.ts",
    "test": "vitest run && bun run runtime/main.ts --fixtures && bun run runtime/tutor-main.ts --fixtures && bun run proof:d1",
    "check-types": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@effect/sql-d1": "catalog:effect-v4",
    "@noble/hashes": "2.3.0",
    "effect": "catalog:effect-v4"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect-v4",
    "@types/node": "^22",
    "miniflare": "4.20260706.0",
    "oxlint": "^1.41.0",
    "typescript": "^5",
    "vitest": "catalog:effect-v4"
  }
}
