{
  "name": "@vektorprogrammet/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./data": "./src/data.ts",
    "./laws": "./src/laws.ts",
    "./report": "./src/report.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "scripts": {
    "report": "bun run src/main.ts",
    "proof:d1": "bun run src/tutor/d1-proof.ts",
    "test": "vitest run && bun run src/main.ts --fixtures && bun run src/tutor/main.ts --fixtures && bun run proof:d1",
    "check-types": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@effect/sql-d1": "catalog:effect-v4",
    "effect": "catalog:effect-v4"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect-v4",
    "@types/node": "^22",
    "miniflare": "4.20260706.0",
    "oxlint": "^1.41.0",
    "typescript": "^5",
    "vitest": "catalog:effect-v4"
  }
}
