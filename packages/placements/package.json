{
  "name": "@vektorprogrammet/placements",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": "./src/contracts.ts",
    "./server": "./src/server/index.ts"
  },
  "scripts": {
    "test": "vitest run --no-file-parallelism --maxWorkers=1",
    "check-types": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "oxlint",
    "docs:examples": "bun --no-env-file examples/affiliation.ts && bun --no-env-file examples/read-scopes.ts",
    "docs:generate": "bun --no-env-file ../../tools/system-guide/placements.ts generate",
    "docs:check": "bun --no-env-file ../../tools/system-guide/placements.ts check",
    "docs:ci": "bun --no-env-file ../../tools/system-guide/placements.ts ci",
    "docs:accept": "bun --no-env-file ../../tools/system-guide/placements.ts accept"
  },
  "dependencies": {
    "@vektorprogrammet/database": "workspace:*",
    "@vektorprogrammet/domain": "workspace:*",
    "effect": "catalog:effect-v4",
    "pg": "8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.41.0",
    "typescript": "7.0.2",
    "vitest": "catalog:effect-v4"
  }
}
