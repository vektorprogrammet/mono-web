{
  "name": "@vektorprogrammet/sdk",
  "version": "0.3.0",
  "homepage": "https://github.com/vektorprogrammet/mono-web",
  "files": [
    "dist",
    "native-api-operations.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@vektorprogrammet/source": "./src/promise.ts",
      "types": "./dist/promise.d.ts",
      "default": "./dist/promise.js"
    },
    "./effect": {
      "@vektorprogrammet/source": "./src/effect-client.ts",
      "types": "./dist/effect-client.d.ts",
      "default": "./dist/effect-client.js"
    },
    "./operations": "./native-api-operations.json"
  },
  "scripts": {
    "generate": "bun run scripts/generate-operations.ts",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run",
    "prepack": "bun run generate",
    "release": "changeset publish"
  },
  "dependencies": {
    "@vektorprogrammet/http-api": "workspace:*",
    "effect": "catalog:effect-v4"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect-v4",
    "@types/node": "^22",
    "typescript": "7.0.2",
    "vitest": "catalog:effect-v4"
  }
}
