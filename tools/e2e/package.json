{
  "name": "@monoweb/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.bun.json",
    "rehearsal:legacy-person": "bun --no-env-file ../../scripts/require-legacy-data-profile.ts && bun run run-legacy-backup-person-rehearsal.ts",
    "cutover:legacy-service": "bun run run-legacy-service-cutover.ts",
    "rehearsal:legacy-current-assignment": "bun --no-env-file ../../scripts/require-legacy-data-profile.ts && bun --no-env-file run-legacy-current-assignment-rehearsal.ts",
    "rehearsal:legacy-organization": "bun --no-env-file ../../scripts/require-legacy-data-profile.ts && bun --no-env-file run-legacy-organization-rehearsal.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:effect-v4",
    "@monoweb/postgres": "workspace:*",
    "@vektorprogrammet/backend": "workspace:*",
    "@vektorprogrammet/database": "workspace:*",
    "@vektorprogrammet/domain": "workspace:*",
    "@vektorprogrammet/http-api": "workspace:*",
    "effect": "catalog:effect-v4",
    "mysql2": "^3.15.3",
    "pg": "8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "typescript": "7.0.2"
  }
}
