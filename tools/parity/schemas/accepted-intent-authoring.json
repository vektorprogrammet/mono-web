{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vektorprogrammet:functional-parity-accepted-intent-authoring:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selected_revision_ref_ids", "intents", "journeys"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "functional-parity-accepted-intent-authoring/v1"
    },
    "selected_revision_ref_ids": {
      "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/revisionRefs"
    },
    "intents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/intent" } },
    "journeys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/journey" } }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_ref_id",
        "intent_revision",
        "source_ref_ids",
        "purpose",
        "disposition",
        "row_ids",
        "canonical_signatures",
        "inventory_kinds",
        "journey_ref_ids"
      ],
      "properties": {
        "intent_ref_id": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/intentRef"
        },
        "intent_revision": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/safeScalar"
        },
        "source_ref_ids": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/sourceRefs"
        },
        "purpose": { "type": "string", "enum": ["coverage", "disposition"] },
        "disposition": {
          "anyOf": [
            {
              "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/acceptedDisposition"
            },
            { "type": "null" }
          ]
        },
        "row_ids": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/rowRefs"
        },
        "canonical_signatures": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/canonicalSignatures"
        },
        "inventory_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/inventoryKind"
          }
        },
        "journey_ref_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/intentRef"
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "purpose": { "const": "coverage" } }, "required": ["purpose"] },
          "then": {
            "properties": {
              "disposition": { "type": "null" },
              "journey_ref_ids": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "purpose": { "const": "disposition" } },
            "required": ["purpose"]
          },
          "then": {
            "properties": {
              "disposition": {
                "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/acceptedDisposition"
              },
              "journey_ref_ids": { "maxItems": 0 }
            },
            "anyOf": [
              { "properties": { "row_ids": { "minItems": 1 } } },
              { "properties": { "canonical_signatures": { "minItems": 1 } } }
            ]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "surface",
        "row_ids",
        "canonical_signatures",
        "expected_contract_ref",
        "runtime_evidence_ref_ids"
      ],
      "properties": {
        "step_id": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/safeScalar"
        },
        "surface": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/inventoryKind"
        },
        "row_ids": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/rowRefs"
        },
        "canonical_signatures": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/canonicalSignatures"
        },
        "expected_contract_ref": {
          "anyOf": [
            {
              "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/safeScalar"
            },
            { "type": "null" }
          ]
        },
        "runtime_evidence_ref_ids": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/uniqueSafeScalars"
        }
      },
      "anyOf": [
        { "properties": { "row_ids": { "minItems": 1 } } },
        { "properties": { "canonical_signatures": { "minItems": 1 } } }
      ]
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journey_ref_id",
        "journey_key",
        "intent_ref_id",
        "journey_revision",
        "source_ref_ids",
        "steps",
        "coverage_scope"
      ],
      "properties": {
        "journey_ref_id": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/intentRef"
        },
        "journey_key": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/safeScalar"
        },
        "intent_ref_id": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/intentRef"
        },
        "journey_revision": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/safeScalar"
        },
        "source_ref_ids": {
          "$ref": "urn:vektorprogrammet:functional-parity-accepted-intent:v1#/$defs/sourceRefs"
        },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "coverage_scope": {
          "type": "string",
          "enum": ["user_visible", "operator_visible", "background", "accepted_non_user_facing"]
        }
      }
    }
  }
}
