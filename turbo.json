{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "generate"]
    },
    "api:spec": {
      "cache": false
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": ["openapi.json", "native-api-operations.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
